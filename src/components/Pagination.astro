---
const { page } = Astro.props;
---

<nav class="flex items-center justify-between mt-16 border-t border-muted pt-8">
    <div class="flex-1 flex justify-start">
        {page.url.prev ? (
            <a 
                href={page.url.prev} 
                class="group flex items-center gap-2 text-sm font-bold uppercase tracking-widest hover:text-brand transition-colors"
            >
                <span class="group-hover:-translate-x-1 transition-transform">←</span>
                <span class="lang-zh">上一页</span>
                <span class="lang-en">Newer</span>
            </a>
        ) : (
            <span class="text-sm font-bold uppercase tracking-widest text-muted-foreground/30 cursor-not-allowed">
                ← <span class="lang-zh">上一页</span><span class="lang-en">Newer</span>
            </span>
        )}
    </div>

    <div class="hidden md:flex items-center gap-4">
        <span class="text-xs font-mono text-muted-foreground/60 uppercase tracking-widest">
            <span class="lang-zh">第 {page.currentPage} 页 / 共 {page.lastPage} 页</span>
            <span class="lang-en">Page {page.currentPage} of {page.lastPage}</span>
        </span>
    </div>

    <div class="flex-1 flex justify-end">
        {page.url.next ? (
            <a 
                href={page.url.next} 
                class="group flex items-center gap-2 text-sm font-bold uppercase tracking-widest hover:text-brand transition-colors"
            >
                <span class="lang-zh">下一页</span>
                <span class="lang-en">Older</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
        ) : (
            <span class="text-sm font-bold uppercase tracking-widest text-muted-foreground/30 cursor-not-allowed">
                <span class="lang-zh">下一页</span><span class="lang-en">Older</span> →
            </span>
        )}
    </div>
</nav>
