---
import BaseHead from '../components/BaseHead.astro';
import HeaderLink from '../components/HeaderLink.astro';
import { getSortedBlogPosts } from '../lib/content';

const allPosts = await getSortedBlogPosts();
const recentPosts = allPosts.slice(0, 3);

const coreProjects = [
	{
		title: "univerOS",
		subtitle: "智能体操作系统内核",
		description: "面向下一代自主工程交付的 Agentic OS 内核，分布式状态机与技能蒸馏底座。",
		link: "https://univeros.cn",
		tags: ["Agentic OS", "Delivery", "Kernel"],
		badge: "Core OS",
		badgeColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20"
	},
	{
		title: "网腾科技",
		subtitle: "wangteng.tech",
		description: "中国大陆核心数字运营主体，统筹吉域网云基础设施、Anycast 动态调度与数字矩阵。",
		link: "https://wangteng.tech",
		tags: ["Corporate", "Cloud Infra", "DNS"],
		badge: "Enterprise",
		badgeColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20"
	},
	{
		title: "无限科技",
		subtitle: "wuxian.xyz",
		description: "全平台物联网多级分销系统与智能设备云管平台，赋能软硬件一体化私域商业。",
		link: "https://wuxian.xyz",
		tags: ["IoT Platform", "Cloud Management", "Distribution"],
		badge: "IoT Platform",
		badgeColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20"
	},
	{
		title: "君熹科技",
		subtitle: "junxi.xyz",
		description: "专注于前沿科技原型验证、实验性数字化资产与高频创新的核心前哨。",
		link: "https://junxi.xyz",
		tags: ["Frontier Tech", "Labs", "Innovation"],
		badge: "Innovation Lab",
		badgeColor: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20"
	},
	{
		title: "Qiulot.io",
		subtitle: "Web3 预测与竞技生态",
		description: "基于 Web3 的去中心化赛事预测与体育竞技模拟市场，深度耕耘赔率引擎与数字资产。",
		link: "https://qiulot.io",
		tags: ["Web3", "Prediction Market", "GameFi"],
		badge: "Web3 DApp",
		badgeColor: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20"
	},
	{
		title: "IceHoo Engine",
		subtitle: "模块化游戏服务引擎",
		description: "采用 B.E.D. 技术栈构建的 GaaS 游戏后端云中枢，提供统一身份凭据与高并发资产调度。",
		link: "https://icehoo.com",
		tags: ["GaaS", "Game Engine", "Backend"],
		badge: "Game Platform",
		badgeColor: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20"
	}
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="Glog · 尹霈泽 | 核心导航与数字矩阵" description="尹霈泽 (Geniux) 个人思考沉淀、商业观察与核心技术矩阵导航。" />
		<link rel="shortcut icon" href="/avatar.png" type="image/png">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#fafafa] dark:bg-[#0a0a0a] text-[#1a1a1a] dark:text-[#f0f0f0] font-['Outfit',sans-serif] selection:bg-brand/10 selection:text-brand overflow-x-hidden transition-colors duration-300">
		<!-- 1. Navigation Header -->
		<nav class="w-full h-20 flex justify-center items-center gap-8 relative z-50 bg-white/60 dark:bg-black/60 backdrop-blur-md border-b border-border/40">
			<HeaderLink href="/">HOME</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/projects">Project</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		
		<main class="min-h-[calc(100vh-80px)] w-full flex flex-col items-center pt-8 sm:pt-12 pb-24 px-6 sm:px-12 relative">
			<!-- Background Glow Decorations -->
			<div class="absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden">
				<div class="absolute top-[-5%] left-[-5%] w-[35%] h-[35%] bg-primary/5 blur-[100px] rounded-full"></div>
				<div class="absolute bottom-[-5%] right-[-5%] w-[30%] h-[30%] bg-primary/10 blur-[100px] rounded-full"></div>
			</div>

			<div class="max-w-4xl w-full flex flex-col items-center gap-14 relative z-10 animate-in fade-in slide-in-from-bottom-4 duration-700">
				
				<!-- 2. Hero Profile Section -->
				<div class="flex flex-col items-center text-center gap-6">
					<div class="relative w-32 h-32 sm:w-36 sm:h-36 group">
						<div class="absolute inset-0 border border-dashed border-primary/20 rounded-full animate-[spin_40s_linear_infinite] group-hover:border-primary/40"></div>
						<div class="absolute inset-1.5 rounded-full overflow-hidden border-2 border-white dark:border-white/10 shadow-lg z-10">
							<img src="/avatar.png" alt="Yin Peize Avatar" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" />
						</div>
					</div>

					<div class="space-y-4">
						<div class="flex items-center justify-center gap-2">
							<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-muted/60 text-muted-foreground border border-border">
								<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
								Executionism & Digital Sovereignty
							</span>
						</div>

						<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
							尹霈泽 <span class="text-muted-foreground/60 text-2xl sm:text-3xl font-normal">/ Geniux</span>
						</h1>

						<p class="text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed text-balance">
							架构师、创业者与执行主义者。主张“既定目标不能改变：执行、发现问题、修正方法、继续执行”。深耕智能体操作系统（Agentic OS）、数字主权领地与可量化经济闭环。
						</p>
					</div>

					<!-- Social & Hub Quick Links -->
					<div class="flex flex-wrap justify-center items-center gap-3 pt-2">
						<a href="https://github.com/WT-Agent" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl bg-card border border-border text-xs font-semibold hover:border-primary hover:text-primary transition-all shadow-xs">
							GitHub: @WT-Agent
						</a>
						<a href="https://github.com/Terry-" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl bg-card border border-border text-xs font-semibold hover:border-primary hover:text-primary transition-all shadow-xs">
							GitHub: @Terry-
						</a>
						<a href="/blog" class="px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:opacity-90 transition-all shadow-xs">
							阅读全部博客
						</a>
						<a href="/projects" class="px-4 py-2 rounded-xl bg-muted text-foreground text-xs font-semibold hover:bg-accent transition-all shadow-xs border border-border">
							项目矩阵总览
						</a>
					</div>
				</div>

				<!-- 3. Core Ecosystem Project Matrix (核心项目导航) -->
				<section class="w-full space-y-6 pt-4">
					<div class="flex items-center justify-between border-b border-border/60 pb-3">
						<div>
							<h2 class="text-xl sm:text-2xl font-bold tracking-tight">核心生态矩阵</h2>
							<p class="text-xs text-muted-foreground mt-0.5 font-mono">CORE VENTURES & PLATFORM ECOSYSTEM</p>
						</div>
						<a href="/projects" class="text-xs font-semibold text-primary hover:underline">
							查看全部项目 →
						</a>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{coreProjects.map((p) => (
							<a 
								href={p.link} 
								target="_blank" 
								rel="noopener noreferrer"
								class="group p-5 rounded-2xl bg-card/60 dark:bg-card/40 border border-border/70 hover:border-primary/50 hover:bg-card transition-all duration-300 flex flex-col justify-between shadow-xs hover:shadow-md"
							>
								<div class="space-y-2.5">
									<div class="flex items-center justify-between">
										<div class="flex items-center gap-2">
											<h3 class="font-bold text-lg text-foreground group-hover:text-primary transition-colors">
												{p.title}
											</h3>
											<span class={`text-[10px] font-mono font-semibold px-2 py-0.5 rounded-md border ${p.badgeColor}`}>
												{p.badge}
											</span>
										</div>
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground/60 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
											<path d="M7 17L17 7M17 7H7M17 7V17"/>
										</svg>
									</div>
									<p class="text-xs font-mono text-primary/80">
										{p.subtitle}
									</p>
									<p class="text-xs text-muted-foreground leading-relaxed">
										{p.description}
									</p>
								</div>
								
								<div class="flex flex-wrap gap-1.5 pt-4 mt-auto">
									{p.tags.map((t) => (
										<span class="px-2 py-0.5 text-[10px] font-mono bg-muted/50 rounded text-muted-foreground border border-border/40">
											{t}
										</span>
									))}
								</div>
							</a>
						))}
					</div>
				</section>

				<!-- 4. Recent Insights (最新博客随笔) -->
				<section class="w-full space-y-6 pt-4">
					<div class="flex items-center justify-between border-b border-border/60 pb-3">
						<div>
							<h2 class="text-xl sm:text-2xl font-bold tracking-tight">最新深度思考</h2>
							<p class="text-xs text-muted-foreground mt-0.5 font-mono">RECENT INSIGHTS & ESSAYS</p>
						</div>
						<a href="/blog" class="text-xs font-semibold text-primary hover:underline">
							进入博客库 →
						</a>
					</div>

					<div class="space-y-3">
						{recentPosts.map((post) => (
							<a 
								href={`/blog/${post.id}/`} 
								class="group block p-5 rounded-2xl bg-card/60 dark:bg-card/40 border border-border/70 hover:border-primary/50 hover:bg-card transition-all duration-300 shadow-xs hover:shadow-md"
							>
								<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
									<h3 class="font-bold text-base sm:text-lg text-foreground group-hover:text-primary transition-colors">
										{post.data.title}
									</h3>
									<span class="text-xs font-mono text-muted-foreground shrink-0">
										{new Date(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
									</span>
								</div>
								<p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
									{post.data.description}
								</p>
								<div class="flex flex-wrap gap-1.5 mt-3">
									{post.data.tags.slice(0, 4).map((tag) => (
										<span class="px-2 py-0.5 text-[10px] font-mono bg-muted/40 rounded text-muted-foreground/80 border border-border/30">
											#{tag}
										</span>
									))}
								</div>
							</a>
						))}
					</div>
				</section>

			</div>

			<!-- Footer Copy Link Floating Button -->
			<button id="copy-link" class="fixed bottom-6 right-6 p-3.5 bg-white/90 dark:bg-black/90 backdrop-blur border border-border rounded-full shadow-lg hover:border-primary transition-all active:scale-90" title="复制主页链接">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
			</button>
		</main>

		<script>
			document.getElementById('copy-link')?.addEventListener('click', () => {
				navigator.clipboard.writeText(window.location.href);
				alert('主页链接已复制到剪贴板');
			});
		</script>
	</body>
</html>
