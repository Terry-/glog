---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title="闲话 & AI | geniux.net" 
			description="Geniux (字·霂之，号·霈泽) 个人主页、最新思考与核心产品实践。" 
		/>
		<link rel="shortcut icon" href="/avatar.png" type="image/png">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-background text-foreground antialiased font-['Outfit',sans-serif] selection:bg-brand/10 selection:text-brand overflow-x-hidden transition-colors duration-300">
		<Header />
		
		<main class="min-h-[calc(100vh-80px)] w-full flex flex-col items-center pt-8 sm:pt-12 pb-24 px-6 sm:px-12 relative">
			<div class="max-w-4xl w-full flex flex-col items-center gap-14 relative z-10 animate-in fade-in slide-in-from-bottom-4 duration-700">
				
				<!-- 2. Hero Profile Section -->
				<div class="flex flex-col items-center text-center gap-6">
					<div class="relative w-28 h-28 sm:w-32 sm:h-32">
						<div class="w-full h-full rounded-full overflow-hidden border-2 border-border shadow-xs bg-muted">
							<img src="/avatar.png" alt="Avatar" class="w-full h-full object-cover" />
						</div>
					</div>

					<div class="space-y-4">
						<div class="flex items-center justify-center gap-2">
							<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-muted/50 text-muted-foreground border border-border/60">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
								Executionism & Engineering Delivery
							</span>
						</div>

						<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
							<span class="text-primary">Geniux</span>
							<span class="text-muted-foreground/30 font-light">·</span>
							<span>字 · 霂之</span>
							<span class="text-muted-foreground/30 font-light">·</span>
							<span>号 · 霈泽</span>
						</h1>

						<div class="max-w-2xl space-y-2 text-balance pt-2">
							<p class="text-sm sm:text-base text-foreground/90 font-medium leading-relaxed">
								架构师、创业者与执行主义者。主张“既定目标不能改变：执行、发现问题、修正方法、继续执行”。专注于智能体操作系统（Agentic OS）、云基础设施与自动化工程交付。
							</p>
							<p class="text-xs sm:text-sm text-muted-foreground font-light leading-relaxed">
								Architect, entrepreneur, and executionist. Dedicated to Agentic OS kernels, cloud infrastructure, and autonomous engineering delivery.
							</p>
						</div>
					</div>

					<!-- Quick Jump Buttons in Hero -->
					<div class="flex flex-wrap justify-center items-center gap-3 pt-1">
						<a href="/blog" class="px-5 py-2.5 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:opacity-90 active:scale-[0.98] transition-all duration-300 ease-out shadow-xs">
							进入博客 / Read Essays
						</a>
						<a href="/projects" class="px-5 py-2.5 rounded-xl bg-muted/80 text-foreground text-xs font-semibold hover:bg-muted border border-border/70 active:scale-[0.98] transition-all duration-300 ease-out shadow-xs">
							项目矩阵 / All Projects
						</a>
					</div>
				</div>

				<!-- 3. Recent Essays (最新思考) - Content First -->
				<section class="w-full space-y-5 pt-4">
					<div class="flex items-center justify-between border-b border-border/60 pb-3">
						<div>
							<h2 class="text-xl sm:text-2xl font-bold tracking-tight">最新思考</h2>
							<p class="text-xs text-muted-foreground mt-0.5 font-mono">RECENT ESSAYS</p>
						</div>
						<a href="/blog" class="text-xs font-semibold text-primary hover:underline">
							更多内容 →
						</a>
					</div>

					<div class="space-y-3.5">
						{recentPosts.map((post) => (
							<a 
								href={`/blog/${post.id}/`} 
								class="group block p-5 rounded-2xl bg-card/20 hover:bg-card/60 border border-border/60 hover:border-foreground/25 transition-all duration-300 ease-out"
							>
								<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
									<h3 class="font-bold text-base sm:text-lg text-foreground group-hover:text-primary transition-colors duration-300 ease-out">
										{post.data.title}
									</h3>
									<span class="text-xs font-mono text-muted-foreground shrink-0">
										{new Date(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
									</span>
								</div>
								<p class="text-xs sm:text-sm text-muted-foreground line-clamp-2 leading-relaxed">
									{post.data.description}
								</p>
								<div class="flex flex-wrap gap-1.5 mt-3">
									{post.data.tags.slice(0, 4).map((tag) => (
										<span class="px-2 py-0.5 text-[10px] font-mono bg-muted/40 rounded text-muted-foreground border border-border/30">
											#{tag}
										</span>
									))}
								</div>
							</a>
						))}
					</div>
				</section>

				<!-- 4. Core Products (核心产品) -->
				<section class="w-full space-y-5 pt-4">
					<div class="flex items-center justify-between border-b border-border/60 pb-3">
						<div>
							<h2 class="text-xl sm:text-2xl font-bold tracking-tight">核心产品</h2>
							<p class="text-xs text-muted-foreground mt-0.5 font-mono">CORE PRODUCTS</p>
						</div>
						<a href="/projects" class="text-xs font-semibold text-primary hover:underline">
							全部项目 →
						</a>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{coreProducts.map((p) => (
							<a 
								href={p.link} 
								target="_blank" 
								rel="noopener noreferrer" 
								class="group p-5 rounded-2xl bg-card/20 hover:bg-card/60 border border-border/60 hover:border-foreground/25 transition-all duration-300 ease-out flex flex-col justify-between"
							>
								<div class="space-y-2.5">
									<div class="flex items-center justify-between">
										<h3 class="font-bold text-base sm:text-lg text-foreground group-hover:text-primary transition-colors duration-300 ease-out">
											{p.title} <span class="text-xs text-muted-foreground font-normal font-mono">/ {p.enTitle}</span>
										</h3>
									</div>
									<p class="text-xs font-mono text-muted-foreground">
										{p.subtitle}
									</p>
									<p class="text-xs text-foreground/80 leading-relaxed font-normal">
										{p.description}
									</p>
									<p class="text-[11px] text-muted-foreground leading-relaxed font-light">
										{p.enDescription}
									</p>
								</div>
								
								<div class="flex flex-wrap gap-1.5 pt-4 mt-auto">
									{p.tags.map((t) => (
										<span class="px-2 py-0.5 text-[10px] font-mono bg-muted/40 rounded text-muted-foreground border border-border/30">
											{t}
										</span>
									))}
								</div>
							</a>
						))}
					</div>
				</section>

			</div>

			<!-- Floating Control Buttons (Outer Edge) -->
			<div class="fixed bottom-8 right-6 md:right-8 z-50 flex flex-col gap-3 items-center">
				<button 
					id="copy-link" 
					class="w-10 h-10 flex items-center justify-center bg-background/80 hover:bg-background backdrop-blur-xl border border-border/80 hover:border-foreground/30 text-muted-foreground hover:text-foreground rounded-full shadow-sm transition-all duration-300 ease-out active:scale-[0.96]" 
					title="复制主页链接 / Copy Link" 
					aria-label="复制主页链接"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
				</button>
				<button 
					id="back-to-top" 
					class="w-10 h-10 flex items-center justify-center bg-background/80 hover:bg-background backdrop-blur-xl border border-border/80 hover:border-foreground/30 text-muted-foreground hover:text-foreground rounded-full shadow-sm transition-all duration-300 ease-out transform translate-y-20 opacity-0 pointer-events-none focus-visible:outline-2 focus-visible:outline-ring active:scale-[0.96]" 
					title="Back to Top" 
					aria-label="Back to Top"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
				</button>
			</div>

			<!-- Toast Notification -->
			<div id="copy-toast" class="fixed bottom-24 right-6 md:right-8 px-4 py-2.5 bg-foreground text-background text-xs font-semibold rounded-2xl shadow-2xl opacity-0 pointer-events-none transition-all duration-300 translate-y-2 z-50 flex items-center gap-2 border border-border/20">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-500"><polyline points="20 6 9 17 4 12"/></svg>
				<span>主页链接已复制到剪贴板</span>
			</div>
		</main>

		<!-- 5. Footer with Personal & Social Links -->
		<footer class="w-full border-t border-border/60 bg-white/40 dark:bg-black/40 backdrop-blur py-12 px-6 flex flex-col items-center gap-6 relative z-10">
			<div class="flex flex-wrap justify-center items-center gap-3">
				{socialLinks.map((social) => (
					<a 
						href={social.href} 
						target={social.href.startsWith('mailto') ? '_self' : '_blank'} 
						rel={social.href.startsWith('mailto') ? '' : 'noopener noreferrer'} 
						title={social.name}
						class="p-2.5 border border-border/70 hover:border-foreground/30 text-muted-foreground hover:text-foreground rounded-xl transition-all duration-300 ease-out hover:bg-card/60 active:scale-95 bg-card/30 shadow-xs"
					>
						<span class="sr-only">{social.name}</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class={social.href.startsWith('mailto') ? 'fill-none stroke-current' : ''}>
							<path d={social.icon} stroke-width={social.href.startsWith('mailto') ? '2' : '0'}/>
						</svg>
					</a>
				))}
			</div>
			<p class="text-xs text-muted-foreground font-mono text-center">
				© {new Date().getFullYear()} Geniux
			</p>
		</footer>

		<script>
			function setupControls() {
				// Copy Link
				const copyBtn = document.getElementById('copy-link');
				const toast = document.getElementById('copy-toast');
				if (copyBtn && copyBtn.dataset.bound !== 'true') {
					copyBtn.dataset.bound = 'true';
					copyBtn.addEventListener('click', async () => {
						const url = window.location.origin + '/';
						let copied = false;
						try {
							if (navigator.clipboard && window.isSecureContext) {
								await navigator.clipboard.writeText(url);
								copied = true;
							}
						} catch (e) {
							copied = false;
						}

						if (!copied) {
							try {
								const textArea = document.createElement('textarea');
								textArea.value = url;
								textArea.style.position = 'fixed';
								textArea.style.opacity = '0';
								textArea.style.left = '-999999px';
								document.body.appendChild(textArea);
								textArea.focus();
								textArea.select();
								copied = document.execCommand('copy');
								textArea.remove();
							} catch (e) {
								copied = false;
							}
						}

						if (toast) {
							toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
							toast.classList.add('opacity-100', 'translate-y-0');
							setTimeout(() => {
								toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
								toast.classList.remove('opacity-100', 'translate-y-0');
							}, 2500);
						}
					});
				}

				// Back to Top
				const topBtn = document.getElementById('back-to-top');
				if (topBtn && topBtn.dataset.bound !== 'true') {
					topBtn.dataset.bound = 'true';
					const updatePosition = () => {
						if (window.scrollY > 400) {
							topBtn.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
							topBtn.classList.add('translate-y-0', 'opacity-100');
						} else {
							topBtn.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
							topBtn.classList.remove('translate-y-0', 'opacity-100');
						}
					};

					window.addEventListener('scroll', updatePosition);
					topBtn.addEventListener('click', () => {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
					updatePosition();
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupControls);
			} else {
				setupControls();
			}
			document.addEventListener('astro:page-load', setupControls);
		</script>
	</body>
</html>
